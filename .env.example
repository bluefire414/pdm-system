# ============================================
# PDM 系統生產環境變數模板
# 部署前請複製為 .env 並填入真實值
# ============================================

# 數據庫密碼（務必修改為強密碼）
DB_PASSWORD=your-strong-db-password-here

# JWT 簽名密鑰（務必修改為隨機長字符串，如 openssl rand -base64 32）
JWT_SECRET=your-jwt-secret-change-me-immediately

# 可選：允許跨域來源（多個用逗號分隔）
# 同域部署時可留空，由 Nginx 代理處理
# ALLOWED_ORIGINS=https://pdm.salecomlab.com
