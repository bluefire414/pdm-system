# ============================================================
# PDM 系統後端環境變數說明
# 複製此檔案為 .env 並填入實際值
# ============================================================

# 資料庫連線（本地 SQLite）
DATABASE_URL="file:./dev.db"

# JWT 金鑰（生產環境務必改為隨機長字串）
JWT_SECRET=change-this-to-a-random-secret-in-production

# 伺服器埠號
PORT=3001

# 上傳檔案儲存路徑
UPLOAD_DIR="./uploads"

# 允許的前端來源（多個用逗號分隔）
ALLOWED_ORIGINS=http://localhost:5173

# 前端網址（Email 中的連結按鈕會使用此網址）
FRONTEND_URL=http://localhost:5173

# ============================================================
# SMTP Email 設定（選填）
# 未設定時系統仍可正常運作，僅跳過寄信功能
# ============================================================

# SMTP 伺服器主機
# 常見範例：
#   Gmail: smtp.gmail.com（需開啟應用程式密碼）
#   Outlook: smtp.office365.com
#   阿里雲 DirectMail: smtpdm.aliyun.com
SMTP_HOST=smtp.example.com

# SMTP 埠號（587 = STARTTLS，465 = SSL/TLS）
SMTP_PORT=587

# SMTP 驗證帳號（通常為完整 Email 地址）
SMTP_USER=your@email.com

# SMTP 驗證密碼或應用程式密碼
SMTP_PASS=your-smtp-password

# 寄件人顯示名稱與地址
SMTP_FROM="PDM 系統 <noreply@your-domain.com>"
