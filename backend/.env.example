# ============================================================
# PDM 系統後端環境變數說明
# 複製此檔案為 .env 並填入實際值
# ============================================================

# 資料庫連線（本地 SQLite；生產環境改為 PostgreSQL URL）
DATABASE_URL="file:./dev.db"

# JWT 金鑰（生產環境務必改為 32 字元以上的隨機字串）
JWT_SECRET=change-this-to-a-random-secret-in-production

# 伺服器埠號
PORT=3001

# 上傳檔案儲存路徑
UPLOAD_DIR="./uploads"

# 允許的前端來源（多個用逗號分隔）
ALLOWED_ORIGINS=http://localhost:5173

# 前端網址（Email 中的按鈕連結會使用此網址）
FRONTEND_URL=http://localhost:5173

# ============================================================
# Resend Email 設定（選填）
# 未設定時系統仍可正常運作，僅跳過所有寄信功能
# 申請網址：https://resend.com
# ============================================================

# Resend API Key（在 Resend 控制台建立）
RESEND_API_KEY=re_your_api_key_here

# 寄件人顯示名稱與地址
# 地址必須使用 Resend 已驗證的網域
# 範例：PDM系統 <noreply@send.yourdomain.com>
EMAIL_FROM=PDM系統 <noreply@send.yourdomain.com>
