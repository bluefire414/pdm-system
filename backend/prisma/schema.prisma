generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  name      String
  email     String?
  role      String   @default("ENGINEER")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdDocuments Document[]     @relation("CreatedBy")
  reviewedECNs     ECN[]          @relation("ReviewedBy")
  notifications    Notification[]
  auditLogs        AuditLog[]

  @@index([role])
}

model PartCategory {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?
  parts       Part[]
}

model ProductSeries {
  id          String    @id @default(uuid())
  code        String    @unique
  name        String
  description String?
  products    Product[]
}

model Part {
  id            String         @id @default(uuid())
  partNumber    String         @unique
  name          String
  description   String?
  categoryId    String
  category      PartCategory   @relation(fields: [categoryId], references: [id])
  documentParts DocumentPart[]
  productBOMs   ProductBOM[]

  @@index([categoryId])
}

model Product {
  id               String           @id @default(uuid())
  productCode      String           @unique
  name             String
  description      String?
  seriesId         String
  series           ProductSeries    @relation(fields: [seriesId], references: [id])
  boms             ProductBOM[]
  documentProducts DocumentProduct[]

  @@index([seriesId])
}

model ProductBOM {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  partId    String
  part      Part    @relation(fields: [partId], references: [id], onDelete: Cascade)
  quantity  Int     @default(1)

  @@unique([productId, partId])
}

model DocumentCategory {
  id          String     @id @default(uuid())
  code        String     @unique
  name        String
  description String?
  documents   Document[]
}

model Document {
  id           String            @id @default(uuid())
  categoryId   String?
  category     DocumentCategory? @relation(fields: [categoryId], references: [id])
  documentType String
  status       String            @default("DRAFT")
  version      Int               @default(1)
  remark       String?
  createdById  String
  createdBy    User              @relation("CreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  parts    DocumentPart[]
  products DocumentProduct[]
  files    DocumentFile[]
  ecns     ECN[]
  versions DocumentVersion[]
  ecrs     ECR[]

  @@index([status])
  @@index([documentType])
  @@index([createdById])
  @@index([categoryId])
}

model DocumentFile {
  id           String   @id @default(uuid())
  documentId   String
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  fileType     String
  fileName     String
  originalName String
  filePath     String
  fileSize     Int
  mimeType     String
  createdAt    DateTime @default(now())

  @@index([documentId])
}

model DocumentPart {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  partId     String
  part       Part     @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@unique([documentId, partId])
  @@index([documentId])
  @@index([partId])
}

model DocumentProduct {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([documentId, productId])
  @@index([documentId])
  @@index([productId])
}

model ECN {
  id           String    @id @default(uuid())
  ecnNo        String    @unique
  title        String
  description  String
  status       String    @default("PENDING")
  dueDate      DateTime?
  documentId   String
  document     Document  @relation(fields: [documentId], references: [id])
  reviewedById String?
  reviewedBy   User?     @relation("ReviewedBy", fields: [reviewedById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([documentId])
}

model DocumentVersion {
  id            String   @id @default(uuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version       Int
  status        String
  ecnId         String?
  filesSnapshot String   // JSON 序列化，儲存快照當時所有 DocumentFile 的摘要
  createdBy     String   // 操作者 userId
  snapshotAt    DateTime @default(now())

  @@index([documentId])
  @@index([documentId, version])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

model ECR {
  id          String   @id @default(uuid())
  ecrNumber   String   @unique
  title       String
  description String?
  reason      String?
  documentId  String
  document    Document @relation(fields: [documentId], references: [id])
  requesterId String
  status      String   @default("DRAFT")
  ecnId       String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([documentId])
  @@index([requesterId])
  @@index([status])
}

model WorkflowTemplate {
  id         String         @id @default(uuid())
  name       String
  entityType String
  isActive   Boolean        @default(true)
  steps      WorkflowStep[]
  createdAt  DateTime       @default(now())

  @@index([entityType, isActive])
}

model WorkflowStep {
  id              String           @id @default(uuid())
  templateId      String
  template        WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  order           Int
  name            String
  approverRole    String
  isRequired      Boolean          @default(true)
  approvalRecords ApprovalRecord[]

  @@unique([templateId, order])
  @@index([templateId])
}

model ApprovalRecord {
  id         String       @id @default(uuid())
  entityType String
  entityId   String
  stepId     String
  step       WorkflowStep @relation(fields: [stepId], references: [id])
  order      Int
  status     String       @default("PENDING")
  approverId String?
  comment    String?
  actionAt   DateTime?
  createdAt  DateTime     @default(now())

  @@index([entityType, entityId])
  @@index([entityType, entityId, status])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String
  detail    String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([action])
  @@index([createdAt])
}
